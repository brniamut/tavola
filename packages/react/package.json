{
  "name": "@tavola/react",
  "version": "0.0.0",
  "description": "An admin data table for React: sorting, filters, column picker, drag-to-reorder, resizing, pinning, selection and saved layouts, on TanStack Table.",
  "keywords": [
    "admin",
    "data-table",
    "datagrid",
    "react",
    "table",
    "tanstack-table"
  ],
  "license": "MIT",
  "author": "Penguin Pirates",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/brniamut/tavola.git",
    "directory": "packages/react"
  },
  "files": [
    "dist"
  ],
  "type": "module",
  "sideEffects": [
    "**/*.css"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./styles.css": "./dist/styles.css",
    "./package.json": "./package.json"
  },
  "scripts": {
    "build": "tsdown",
    "test": "vitest run",
    "typecheck": "tsc -p tsconfig.json",
    "check:package": "publint --strict && attw --pack . --profile esm-only --exclude-entrypoints styles.css"
  },
  "dependencies": {
    "@dnd-kit/react": "0.5.3",
    "@tanstack/react-table": "^9.3.1"
  },
  "devDependencies": {
    "@arethetypeswrong/cli": "0.18.5",
    "@tanstack/query-core": "5.106.1",
    "@testing-library/dom": "10.4.2",
    "@testing-library/react": "16.3.3",
    "@testing-library/user-event": "14.6.8",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.2.1",
    "jsdom": "31.0.0",
    "publint": "0.3.25",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "tsdown": "0.23.5",
    "vitest": "5.1.0"
  },
  "peerDependencies": {
    "react": "^18.3.0 || ^19.0.0",
    "react-dom": "^18.3.0 || ^19.0.0"
  }
}
